{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/components/NotificationCenter.tsx",
    "src/components/RateCalendar.tsx",
    "src/components/RateLimitWarning.tsx",
    "src/components/PerformanceMonitor.tsx",
    "src/components/ChannelManager/ChannelManagerDashboard.tsx",
    "src/contexts/AuthContext.tsx",
    "src/hooks/useDatabaseInfo.ts",
    "src/hooks/useHealthCheck.ts",
    "src/hooks/useOptimizedQuery.ts",
    "src/hooks/usePermissions.ts",
    "src/pages/Analytics.tsx",
    "src/pages/Analytics/components/RevenueChart.tsx",
    "src/pages/AuditLogs.tsx",
    "src/pages/CheckOut.tsx",
    "src/pages/ComplianceDashboard.tsx",
    "src/pages/GlobalSearch.tsx",
    "src/pages/Housekeeping.tsx",
    "src/pages/MobileDashboard.tsx",
    "src/pages/MobileReservations.tsx",
    "src/pages/Notifications.tsx",
    "src/pages/Operations.tsx",
    "src/pages/PerformanceDashboard.tsx",
    "src/pages/RatesManagement.tsx",
    "src/pages/UserManagement.tsx",
    "src/pages/UserProfile.tsx",
    "src/utils/performance.ts"
  ]
}
