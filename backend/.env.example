# PMS Hotel Backend — Environment Contract
# Copy this file to backend/.env for local development.
# NEVER commit the real .env file.

# ─── Application ───────────────────────────────────────────────────────────
# APP_ENV controls production-safety behavior. Use "production" in prod.
APP_ENV=development
LOG_LEVEL=INFO

# ─── Secrets (REQUIRED) ────────────────────────────────────────────────────
# Generate fresh values with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY must be >= 32 chars. The server refuses to boot with known
# leaked development values.
SECRET_KEY=
JWT_SECRET_KEY=

# Token used for internal service-to-service calls (POS → Inventory, etc.).
# REQUIRED when APP_ENV=production.
INTERNAL_SERVICE_TOKEN=

# Token used by the CRM sync client when calling back into PMS.
PMS_SERVICE_TOKEN=

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use explicit domains in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ─── Database (PostgreSQL optional; omit for SQLite default) ──────────────
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/pms
# CRM_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/pms_crm

# ─── Cache & queue (required when DATABASE_URL is set) ────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Email (optional) ─────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ─── Feature flags ─────────────────────────────────────────────────────────
# Enforce consent gate on outbound CRM communications. Leave false during
# Phase 1 rollout; flip to true once consent records are backfilled.
CRM_ENFORCE_CONSENT=false

# ─── Observability (optional) ─────────────────────────────────────────────
# When SENTRY_DSN is set, errors and a sampled fraction of transactions
# are reported to Sentry, tagged with tenant_id/user_id/request_id.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=

# Days to retain audit_logs before the retention sweeper deletes them.
# Set to 0 to disable retention. Default: 365.
AUDIT_RETENTION_DAYS=365

# ─── Legacy / dev-server ───────────────────────────────────────────────────
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
